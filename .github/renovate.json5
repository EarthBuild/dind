{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'security:openssf-scorecard',
    ':semanticCommits',
  ],
  forkProcessing: 'enabled',
  dockerfile: {
    managerFilePatterns: [
      '**/Earthfile',
    ],
  },
  customDatasources: {
    'alpine-docker': {
      defaultRegistryUrlTemplate: 'https://pkgs.alpinelinux.org/package/v{{{packageName}}}/community/x86_64/docker',
      format: 'html',
      transformTemplates: [
        '{"releases": [releases[$contains(version, "buildlogs")].{"version": $match(version, /docker-(.*?)\\.log/).groups[0]}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '**/Earthfile',
      ],
      matchStrings: [
        '\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?[\\s\\n]+(versioning=(?<versioning>\\S+)\\s+)?(ARG|LET)\\s+.*?(_VERSION|_VER|version)=(?<currentValue>.*?)($|\\s|\\n)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '.arg',
      ],
      matchStrings: [
        'EARTHLY_REPO_VERSION=(?<currentDigest>[a-f0-9]+)',
      ],
      currentValueTemplate: 'main',
      depNameTemplate: 'earthbuild/earthbuild',
      packageNameTemplate: 'https://github.com/earthbuild/earthbuild',
      datasourceTemplate: 'git-refs',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        'README.md',
      ],
      matchStrings: [
        '\\*\\s+\\`alpine-(?<major>\\d+)\\.(?<minor>\\d+)-docker-(?<currentValue>.*?)\\`\\n',
      ],
      depNameTemplate: 'alpine_{{{major}}}_{{{minor}}}/docker',
      packageNameTemplate: '{{{major}}}.{{{minor}}}',
      datasourceTemplate: 'custom.alpine-docker',
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        'README.md',
      ],
      matchStrings: [
        '\\*\\s+\\`ubuntu-(?<osVersion>\\d+\\.\\d+)-docker-(?<currentValue>.*?)-\\d+\\`\\n',
      ],
      depNameTemplate: 'moby/moby-{{{osVersion}}}',
      packageNameTemplate: 'moby/moby',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  labels: [
    'renovate',
  ],
  packageRules: [
    {
      // Lock docker to v28.1.1 for Ubuntu 20.04 and disable updates.
      matchDepNames: [
        'moby/moby-20.04',
      ],
      allowedVersions: '28.1.1',
      enabled: false,
    },
    {
      matchPackageNames: [
        'moby/moby',
      ],
      matchDatasources: [
        'github-releases',
      ],
      extractVersion: '^(?:docker-)?v?(?<version>\\d+\\.\\d+\\.\\d+.*)$',
      versioning: 'semver',
      separateMultipleMajor: true,
    },
    {
      matchDepNames: [
        '/^alpine_.*\\/docker$/',
      ],
      allowedVersions: '!/.*_.*|\\b(alpha|beta|rc)\\b/',
    },
    {
      automerge: true,
      matchPackageNames: [
        '*',
      ],
    },
  ],
}
